<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rsdkRemoteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rsdk_console_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/rsdkToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="4dp"
            app:navigationIcon="@drawable/ic_rsdk_close"
            app:navigationIconTint="@color/rsdk_text_primary"
            app:title="@string/rsdk_remote_title"
            app:titleTextColor="@color/rsdk_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rsdkCameraIdentity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/rsdk_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Osmo 360" />

                <TextView
                    android:id="@+id/rsdkConnectionState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="@color/rsdk_text_secondary"
                    android:textSize="12sp"
                    tools:text="AA:BB:CC:DD:EE:FF" />
            </LinearLayout>

            <TextView
                android:id="@+id/rsdkConnectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/rsdk_info_badge"
                android:text="@string/rsdk_state_disconnected"
                android:textAllCaps="true"
                android:textColor="@color/rsdk_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rsdkPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/rsdk_panel"
            app:cardCornerRadius="22dp"
            app:strokeColor="@color/rsdk_outline"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rsdk_preview_background">

                <dev.konraditurbe.osmosis.panorama.render.PanoramaSurfaceView
                    android:id="@+id/rsdkPreviewSurface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/rsdk_preview_content_description"
                    android:keepScreenOn="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_gravity="bottom"
                    android:background="#80090C11" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/rsdkPreviewLiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rsdk_live_badge"
                        android:text="@string/rsdk_preview_live"
                        android:textColor="@color/rsdk_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/rsdkPreviewRecordBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/rsdk_live_badge"
                        android:text="@string/rsdk_capture_recording"
                        android:textColor="@color/rsdk_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rsdkPreviewRecenter"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minHeight="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/rsdk_preview_recenter"
                        android:textColor="@color/rsdk_text_primary"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rsdkPreviewLiveAction"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:minHeight="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/rsdk_preview_stop"
                        android:textColor="@color/rsdk_text_primary"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/rsdkPreviewBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rsdk_info_badge"
                        android:textColor="@color/rsdk_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="82%"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rsdkPreviewEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="28dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/rsdkPreviewProgress"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/rsdk_accent"
                        app:indicatorSize="32dp"
                        app:trackThickness="3dp"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/rsdkPreviewIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_rsdk_preview"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/rsdkPreviewState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/rsdk_preview_ready"
                        android:textColor="@color/rsdk_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rsdkPreviewDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/rsdk_preview_start_hint"
                        android:textColor="@color/rsdk_text_secondary"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rsdkPreviewAction"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:minHeight="40dp"
                        android:text="@string/rsdk_preview_start"
                        android:textColor="@color/rsdk_accent"
                        app:icon="@drawable/ic_rsdk_preview"
                        app:iconSize="18dp"
                        app:iconTint="@color/rsdk_accent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/rsdkStatusPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/rsdk_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Video · recording" />

                    <TextView
                        android:id="@+id/rsdkPreviewMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/rsdk_text_secondary"
                        android:textSize="11sp"
                        tools:text="1280 × 720 · H.264 · 30 fps" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/rsdkApprovalHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:text="@string/rsdk_approval_hint"
            android:textColor="@color/rsdk_warning"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkCapture"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/rsdk_capture"
                android:textColor="@color/rsdk_text_primary"
                app:backgroundTint="@color/rsdk_accent_dark"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_rsdk_capture"
                app:iconTint="@color/rsdk_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkRecord"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/rsdk_record_start"
                android:textColor="@color/rsdk_text_primary"
                app:backgroundTint="@color/rsdk_record"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_rsdk_record"
                app:iconTint="@color/rsdk_text_primary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/rsdk_panel"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/rsdk_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rsdk_camera_status"
                    android:textColor="@color/rsdk_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rsdkStatusSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/rsdk_status_waiting"
                    android:textColor="@color/rsdk_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rsdkVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/rsdk_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Firmware 01.02.00.10 · R-SDK 1.0"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/rsdk_panel"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/rsdk_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rsdk_shooting_mode"
                    android:textColor="@color/rsdk_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/rsdkModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/rsdk_accent"
                    android:popupBackground="@color/rsdk_panel_raised" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rsdkApplyMode"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rsdk_apply_mode"
                    android:textColor="@color/rsdk_accent"
                    app:strokeColor="@color/rsdk_outline" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:text="@string/rsdk_quick_actions"
            android:textAllCaps="true"
            android:textColor="@color/rsdk_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkSnapshot"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/rsdk_snapshot"
                android:textColor="@color/rsdk_text_primary"
                app:strokeColor="@color/rsdk_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkQuickSwitch"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/rsdk_quick_switch"
                android:textColor="@color/rsdk_text_primary"
                app:strokeColor="@color/rsdk_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkGps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/rsdk_gps_short"
                android:textColor="@color/rsdk_text_primary"
                app:strokeColor="@color/rsdk_outline" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:text="@string/rsdk_device_actions"
            android:textAllCaps="true"
            android:textColor="@color/rsdk_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/rsdk_connect"
                android:textColor="@color/rsdk_console_background"
                app:backgroundTint="@color/rsdk_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkWake"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/rsdk_wake"
                android:textColor="@color/rsdk_text_primary"
                app:strokeColor="@color/rsdk_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkQueryVersion"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/rsdk_query_version"
                android:textColor="@color/rsdk_text_primary"
                app:strokeColor="@color/rsdk_outline" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkSleep"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rsdk_sleep"
                android:textColor="@color/rsdk_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rsdkRestart"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rsdk_restart"
                android:textColor="@color/rsdk_record" />
        </LinearLayout>

        <TextView
            android:id="@+id/rsdkCommandResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rsdk_message_background"
            android:minHeight="42dp"
            android:text="@string/rsdk_command_ready"
            android:textColor="@color/rsdk_text_secondary"
            android:textSize="12sp"
            tools:text="Capture succeeded · sequence 42" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/rsdk_best_effort_notice"
            android:textColor="@color/rsdk_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
