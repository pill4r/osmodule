<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/osmo_bg">

    <!-- Camera selector shown on launch. -->
    <LinearLayout
        android:id="@+id/selectorGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cameras"
                    android:textColor="@color/osmo_ink"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/cameras_subtitle"
                    android:textColor="@color/osmo_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGps"
                style="@style/OsmoIconButton"
                android:layout_marginStart="8dp"
                android:checkable="true"
                android:contentDescription="@string/gps_sync"
                app:icon="@drawable/ic_satellite"
                app:iconTint="@color/osmo_ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVideoFolder"
                style="@style/OsmoIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/video_folder"
                app:icon="@drawable/ic_folder"
                app:iconTint="@color/osmo_ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModules"
                style="@style/OsmoIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/manage_modules"
                android:visibility="gone"
                app:icon="@drawable/ic_modules"
                app:iconTint="@color/osmo_ink"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbout"
                style="@style/OsmoIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/about"
                app:icon="@drawable/ic_info"
                app:iconTint="@color/osmo_ink" />
        </LinearLayout>

        <!-- GPS-sync owns the camera BLE link while active. -->
        <TextView
            android:id="@+id/gpsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/banner_danger_bg"
            android:drawablePadding="10dp"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:textColor="@color/osmo_on_danger"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_satellite"
            app:drawableTint="@color/osmo_on_danger"
            tools:text="GPS sync active — media browsing is paused."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/selectorHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/osmo_muted"
            android:textSize="14sp"
            tools:text="2 cameras nearby" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/connectBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:indicatorColor="@color/osmo_accent"
            app:trackColor="@color/osmo_track"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp" />

        <ListView
            android:id="@+id/cameraList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="8dp"
            android:scrollbarStyle="outsideOverlay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRescan"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/rescan"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart" />
    </LinearLayout>

    <!-- Gallery shown after connecting. -->
    <FrameLayout
        android:id="@+id/gridGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToCameras"
                    style="@style/OsmoIconButton"
                    android:contentDescription="@string/back_to_cameras"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconTint="@color/osmo_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/media_library"
                        android:textColor="@color/osmo_ink"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gallery_subtitle"
                        android:textColor="@color/osmo_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemote"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:contentDescription="@string/remote_control_mode"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/open_remote_control"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_remote"
                    app:iconSize="18dp"
                    tools:visibility="visible" />
            </LinearLayout>

            <dev.konraditurbe.osmosis.ui.StatusPillView
                android:id="@+id/statusPill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterPhotos"
                        style="@style/FilterChip"
                        android:layout_marginEnd="8dp"
                        android:text="@string/filter_photos"
                        app:icon="@drawable/ic_photo"
                        app:iconSize="17dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterVideos"
                        style="@style/FilterChip"
                        android:layout_marginEnd="8dp"
                        android:text="@string/filter_videos"
                        app:icon="@drawable/ic_video"
                        app:iconSize="17dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterFaved"
                        style="@style/FilterChip"
                        android:layout_marginEnd="8dp"
                        android:text="@string/filter_faved"
                        app:icon="@drawable/ic_favorite"
                        app:iconSize="17dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelect"
                        style="@style/FilterChip"
                        android:layout_marginEnd="8dp"
                        android:text="@string/select"
                        app:icon="@drawable/ic_select"
                        app:iconSize="17dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectAll"
                        style="@style/FilterChip"
                        android:checkable="false"
                        android:text="@string/select_all"
                        android:visibility="gone"
                        app:icon="@drawable/ic_select_all"
                        app:iconSize="17dp"
                        tools:visibility="visible" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Space is reserved while idle so the grid does not jump when a transfer starts. -->
            <LinearLayout
                android:id="@+id/progressArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:visibility="invisible">

                <TextView
                    android:id="@+id/overallText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/osmo_muted"
                    android:textSize="11sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/overallBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    app:indicatorColor="@color/osmo_accent"
                    app:trackColor="@color/osmo_track"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="5dp" />

                <TextView
                    android:id="@+id/fileText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/osmo_muted"
                    android:textSize="11sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/fileBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    app:indicatorColor="@color/osmo_green"
                    app:trackColor="@color/osmo_track"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="5dp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingHorizontal="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="96dp"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:id="@+id/emptyGallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="40dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:alpha="0.55"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_media_empty"
                        app:tint="@color/osmo_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/empty_gallery_title"
                        android:textColor="@color/osmo_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/empty_gallery_message"
                        android:textColor="@color/osmo_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loadMoreSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/osmo_accent"
            app:indicatorSize="34dp"
            app:trackThickness="3dp" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="88dp"
            android:text="@string/delete"
            android:textColor="@color/osmo_on_danger"
            android:visibility="gone"
            app:backgroundTint="@color/osmo_danger"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/osmo_on_danger" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:text="@string/download"
            android:textColor="@color/osmo_on_accent"
            android:visibility="gone"
            app:backgroundTint="@color/osmo_accent"
            app:icon="@drawable/ic_download"
            app:iconTint="@color/osmo_on_accent" />
    </FrameLayout>
</FrameLayout>
