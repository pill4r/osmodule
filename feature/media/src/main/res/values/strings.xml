    <string name="about">About</string>
    <string name="about_back">← Back</string>
    <string name="about_title">About osmodule</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">A focused, modular Android client for browsing, transferring and controlling supported DJI Osmo cameras on their local network.</string>
    <string name="about_open_source_title">Open-source projects &amp; references</string>
    <string name="about_open_source_intro">These are the upstream implementations and protocol research explicitly used by osmodule. “Adapted” and “research reference” are distinguished below; tap a project to open its upstream page.</string>
    <string name="about_relationship_inherited_mit">Inherited implementation · MIT</string>
    <string name="about_relationship_adapted_mit">Adapted implementation · MIT</string>
    <string name="about_relationship_adapted_apache">Adapted implementation · Apache-2.0</string>
    <string name="about_relationship_research">Protocol research reference · upstream terms apply</string>
    <string name="about_relationship_dji_sample">Ported and modified · MIT sample; DJI EULA protocol terms</string>
    <string name="about_project_osmosis">Original Android application and the foundation from which osmodule was derived.</string>
    <string name="about_project_open_pocket_cine">Pocket 4P DUML routes, command payloads, status interpretation and HEVC live-view behavior.</string>
    <string name="about_project_osmo360">Osmo 360 UDP/TCP live-view handshake and AVC framing.</string>
    <string name="about_project_panoforge">Osmo 360 factory-calibration metadata decoding and calibrated projection research.</string>
    <string name="about_project_ogs">Reverse-engineered DJI camera protocol research.</string>
    <string name="about_project_dji_remote">Vendored or adapted DUML framing, CRC, byte reader/writer and selected command payloads.</string>
    <string name="about_project_osmo_download">Osmo media discovery and download protocol research.</string>
    <string name="about_project_wifi_connect">DJI camera Wi-Fi connection and pairing research.</string>
    <string name="about_project_osmo_ble">DJI Osmo Bluetooth Low Energy protocol research.</string>
    <string name="about_project_gps_demo">R-SDK framing, CRC, BLE session, commands, GPS push and status handling from DJI\'s published sample.</string>
    <string name="about_project_link_description">Open %1$s upstream project page</string>
    <string name="about_full_notices">Full notices on GitHub</string>
    <string name="about_open_link_failed">No app is available to open this link.</string>
    <string name="about_legal">osmodule\'s original code and Osmosis-derived foundation use the MIT License. Adapted and third-party portions remain under the terms listed above. osmodule is independent and is not affiliated with, authorized by or endorsed by DJI. DJI and Osmo are trademarks of their respective owners.</string>

