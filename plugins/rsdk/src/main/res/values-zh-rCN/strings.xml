<resources>
    <string name="rsdk_plugin_name">Osmo 360 遥控</string>
    <string name="rsdk_plugin_ready">Osmo 360 遥控已安装。\n\n请返回 osmodule，先连接 Osmo 360，再点按设备状态旁的“远控”以使用控制与实时预览。</string>
    <string name="rsdk_permissions_explanation">第 1/2 步 · 这些权限属于 Osmo 360 遥控插件 APK，而不是主应用。远控使用“附近的设备/蓝牙”，本地实时预览还会使用“附近的 Wi-Fi”；位置也用于 GPS 同步；通知为可选权限，只影响是否显示 GPS 同步的常驻通知。</string>
    <string name="rsdk_permissions_grant_remote">允许远控</string>
    <string name="rsdk_permissions_grant_gps">允许 GPS 同步位置</string>
    <string name="rsdk_permissions_grant_notifications">允许 GPS 同步通知（可选）</string>
    <string name="rsdk_permission_granted">已授权</string>
    <string name="rsdk_permission_remote_status">远控基础权限：%1$s</string>
    <string name="rsdk_permission_gps_status">GPS 同步位置：%1$s</string>
    <string name="rsdk_permission_notification_status">GPS 同步通知（可选）：%1$s</string>
    <string name="rsdk_permission_state_granted">已授权</string>
    <string name="rsdk_permission_state_missing">未授权</string>
    <string name="rsdk_autostart_explanation">第 2/2 步 · HyperOS 还需要允许本插件自启动，主应用才能稳定唤起它。自启动不是 Android 运行时权限，必须在系统页面中手动确认。</string>
    <string name="rsdk_autostart_settings">前往 HyperOS 允许自启动</string>
    <string name="rsdk_permissions_settings">打开应用权限设置</string>
</resources>
