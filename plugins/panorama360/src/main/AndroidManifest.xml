<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/panorama_plugin_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- Synchronous first-launch IPC; only the same-signature Base APK may call it. -->
        <provider
            android:name="dev.konraditurbe.osmosis.plugin.PluginBootstrapProvider"
            android:authorities="${applicationId}.bootstrap"
            android:exported="true"
            android:permission="dev.konraditurbe.osmosis.permission.BIND_PLUGIN"
            android:grantUriPermissions="false" />

        <service
            android:name=".PanoramaPluginService"
            android:exported="true"
            android:permission="dev.konraditurbe.osmosis.permission.BIND_PLUGIN">
            <intent-filter>
                <action android:name="dev.konraditurbe.osmosis.plugin.BIND" />
            </intent-filter>
            <meta-data android:name="dev.konraditurbe.osmosis.plugin.ID" android:value="panorama360" />
            <meta-data android:name="dev.konraditurbe.osmosis.plugin.NAME" android:value="osmodule 360 Viewer" />
            <meta-data android:name="dev.konraditurbe.osmosis.plugin.VERSION" android:value="1" />
            <meta-data android:name="dev.konraditurbe.osmosis.plugin.PROTOCOL_MIN" android:value="1" />
            <meta-data android:name="dev.konraditurbe.osmosis.plugin.PROTOCOL_MAX" android:value="1" />
            <meta-data
                android:name="dev.konraditurbe.osmosis.plugin.CAPABILITIES"
                android:value="camera.media.360-view" />
        </service>
    </application>
</manifest>
